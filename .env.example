# ── IA Paysagiste — Configuration multi-provider ─────────────────────────────
# Copiez ce fichier en .env et renseignez vos valeurs :
#   cp .env.example .env

# ── Choix du provider LLM ────────────────────────────────────────────────────
# Valeurs possibles :
#   ollama_local   → Ollama installé localement (GRATUIT, aucune clé requise)
#   ollama_cloud   → Ollama Cloud API (https://api.ollama.com)
#   openai         → OpenAI API (gpt-4o-mini recommandé)
#   anthropic      → Anthropic API (claude-haiku recommandé)
#   mistral        → Mistral AI API

LLM_PROVIDER=ollama_local

# ── Option 1 : Ollama local (recommandé, gratuit) ────────────────────────────
# Installez Ollama : https://ollama.com/download
# Puis lancez :
#   ollama serve
#   ollama pull llama3
# Aucune clé requise. Configurez juste :
#   LLM_PROVIDER=ollama_local
OLLAMA_MODEL=llama3

# ── Option 2 : OpenAI ────────────────────────────────────────────────────────
# Obtenez une clé sur https://platform.openai.com/api-keys
#   LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Option 3 : Anthropic (Claude) ────────────────────────────────────────────
# Obtenez une clé sur https://console.anthropic.com/
#   LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Option 4 : Ollama Cloud ──────────────────────────────────────────────────
# Générez une clé sur https://api.ollama.com
#   LLM_PROVIDER=ollama_cloud
OLLAMA_API_KEY=

# ── Option 5 : Mistral AI ────────────────────────────────────────────────────
# Obtenez une clé sur https://console.mistral.ai/
#   LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
